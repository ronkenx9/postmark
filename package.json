{
  "name": "postmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4326",
    "server": "node server/index.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "verify:chain": "node scripts/verify-chain.mjs",
    "test:api": "node scripts/verify-api.mjs",
    "build:program": "node scripts/build-program.mjs",
    "test:program": "npm run build:program && node scripts/verify-program.mjs",
    "format": "prettier --write src server scripts tests"
  },
