# Leave off until the program has been deployed and verified on devnet.
POSTMARK_CHAIN=off
SOLANA_RPC=https://api.devnet.solana.com
MAGICBLOCK_RPC=https://devnet-as.magicblock.app
# Use a dedicated test wallet only; never put a key in frontend variables.
POSTMARK_DEVNET_KEY=keys/devnet.json

# Vercel hosting requires a dedicated PostgreSQL database. Keep it server-only.
# DATABASE_URL=postgresql://...
